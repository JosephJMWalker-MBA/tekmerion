{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerial-soft.example/schemas/tekmerion/parser-artifact.schema.json",
  "title": "Tekmerion Parser Artifact",
  "description": "Versioned artifact emitted by a deterministic or probabilistic document-processing stage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "run_id",
    "agreement_version_id",
    "stage",
    "stage_version",
    "created_at",
    "inputs",
    "outputs",
    "warnings",
    "metrics",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "artifact_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "agreement_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "stage": {
      "type": "string",
      "enum": [
        "source_validation",
        "page_rendering",
        "embedded_text_extraction",
        "ocr",
        "text_normalization",
        "clause_segmentation",
        "party_extraction",
        "date_extraction",
        "recurrence_extraction",
        "responsibility_extraction",
        "obligation_candidate_generation"
      ]
    },
    "stage_version": {
      "type": "string"
    },
    "ruleset_version": {
      "type": ["string", "null"]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "model_name": {"type": ["string", "null"]},
        "model_version": {"type": ["string", "null"]},
        "runtime": {"type": ["string", "null"]}
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "succeeded_with_warnings", "failed", "skipped"]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifactReference"}
    },
    "outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/outputArtifact"}
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/warning"}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "string", "boolean", "null"]
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": true
    },
    "failure": {
      "oneOf": [
        {"$ref": "#/$defs/failure"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "artifact_id", "sha256"],
      "properties": {
        "artifact_type": {
          "type": "string",
          "enum": [
            "source_file",
            "page_image",
            "embedded_text",
            "ocr_text",
            "normalized_text",
            "clause_set",
            "candidate_set",
            "prior_stage_artifact"
          ]
        },
        "artifact_id": {"type": "string", "format": "uuid"},
        "path": {"type": ["string", "null"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": ["string", "null"]},
        "page_number": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_start", "page_end"],
      "properties": {
        "page_start": {"type": "integer", "minimum": 1},
        "page_end": {"type": "integer", "minimum": 1},
        "character_start": {"type": ["integer", "null"], "minimum": 0},
        "character_end": {"type": ["integer", "null"], "minimum": 0},
        "bounding_boxes": {
          "type": "array",
          "items": {"$ref": "#/$defs/boundingBox"}
        },
        "source_text": {"type": ["string", "null"]}
      }
    },
    "boundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "x", "y", "width", "height", "coordinate_space"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "minimum": 0},
        "height": {"type": "number", "minimum": 0},
        "coordinate_space": {
          "type": "string",
          "enum": ["pixels", "normalized_0_1", "pdf_points"]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "candidate_type", "value", "confidence", "provenance", "review_state"],
      "properties": {
        "candidate_id": {"type": "string", "format": "uuid"},
        "candidate_type": {
          "type": "string",
          "enum": [
            "party",
            "property_address",
            "effective_date",
            "termination_date",
            "clause",
            "due_date",
            "recurrence",
            "responsible_party",
            "benefited_party",
            "obligation"
          ]
        },
        "value": {},
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambiguity_flags": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "review_state": {
          "type": "string",
          "enum": ["pending", "confirmed", "corrected", "rejected"]
        },
        "human_review": {
          "oneOf": [
            {"$ref": "#/$defs/humanReview"},
            {"type": "null"}
          ]
        }
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reviewed_at"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["confirm", "correct", "reject"]
        },
        "reviewed_at": {"type": "string", "format": "date-time"},
        "reviewed_by_party_id": {"type": ["string", "null"], "format": "uuid"},
        "corrected_value": {},
        "note": {"type": ["string", "null"]}
      }
    },
    "outputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "artifact_id", "sha256"],
      "properties": {
        "artifact_type": {
          "type": "string",
          "enum": [
            "page_image",
            "embedded_text",
            "ocr_text",
            "normalized_text",
            "clause_set",
            "candidate_set",
            "stage_report"
          ]
        },
        "artifact_id": {"type": "string", "format": "uuid"},
        "path": {"type": ["string", "null"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": ["string", "null"]},
        "page_number": {"type": ["integer", "null"], "minimum": 1},
        "text": {"type": ["string", "null"]},
        "candidates": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidate"}
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string"},
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error"]
        },
        "message": {"type": "string"},
        "page_number": {"type": ["integer", "null"], "minimum": 1},
        "candidate_id": {"type": ["string", "null"], "format": "uuid"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "retryable": {"type": "boolean"},
        "details": {"type": "object", "additionalProperties": true}
      }
    }
  }
}
